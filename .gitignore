# 의존성
node_modules/

# 빌드 산출물
dist/
dist-tsc/
build/
.vite/
.turbo/
*.tsbuildinfo

# 환경 변수 / 비밀값
# ★ 저장소가 Public이므로 이 구역이 가장 중요하다.
#   DATABASE_URL / GEMINI_API_KEY / SESSION_SECRET이 한 번이라도 커밋되면
#   히스토리에 영구히 남고 공개 저장소는 봇이 자동으로 스캔한다.
#   실제 비밀값은 로컬 .env 와 GitHub Actions Secrets / Render 환경 변수로만 관리한다.
.env
.env.*
*.pem
*.key
secrets.json
# 단 .env.example 은 "변수 이름만" 담은 템플릿이므로 추적한다 (guide 55-1절)
!.env.example

# 로그
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 테스트 / 커버리지
coverage/
playwright-report/
test-results/

# 로컬 DB 파일
*.sqlite
*.sqlite3

# DB 백업. 개인 데이터가 들어 있으므로 저장소에 넣지 않는다.
backups/

# 조사·실험용 임시 폴더
# 저장소에 넣지 않는다.
tmp/

# OS / 편집기
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*~

# ★ R048 — 특별 이모티콘 원본 그림 (캐릭터 저작물 · 저장소가 public) — 폴더와 README 만 git 에, 그림은 DB 가 정본 (D-230)
#   찬종이 git 에도 넣기로 하면 아래 한 줄만 뺀다
assets/emoji/*/

# ★ R048 — verify 가 찍는 화면 검사 그림(라운드 기록이 아니다 — 라운드 그림은 docs/design/rNNN/)
docs/design/verify/

# 미니게임 그림 — 공개 저장소에 넣지 않는다(docs/18 0장 · README 만 커밋)
assets/minigame/*/

# ★ R107 (D-364) — Cloudflare 터널 인증 · 설정. 실제 파일은 사용자 폴더 .cloudflared 에 둔다(저장소 밖).
#   혹시 저장소로 복사해 와도 들어가지 않게(본보기 ops/cloudflared.example.yml 만 추적).
.cloudflared/
ops/cloudflared.yml
ops/config.yml
cert.pem

# 검사 · 판정이 돌 때마다 다시 생기는 것(2026-11-28 정리) — 커밋하지 않는다
data/pipeline/audit/*-raw/tmp*/
data/pipeline/audit/*-raw/_work/
data/pipeline/audit/*-raw/_cache/
docs/design/r[0-9]*-*/
docs/design/r123gb/
docs/design/r123solo/
