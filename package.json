{
  "name": "quiz-web",
  "private": true,
  "version": "0.1.0",
  "description": "실시간 상식 퀴즈 웹게임. 채팅 = 답안 구조의 선착순 멀티플레이.",
  "license": "MIT",
  "workspaces": [
    "shared",
    "server",
    "client",
    "pipeline"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev -w client",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b shared server client pipeline",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "db:reset": "node scripts/migrate.mjs --reset",
    "bot": "node scripts/bot.mjs",
    "reset-password": "node scripts/reset-password.mjs",
    "verify:gemini": "node scripts/verify-gemini.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm test && npm run smoke && npm run ui-check",
    "build:force": "tsc -b shared server client --force && npm run build -w client",
    "ui-check": "node scripts/ui-check.mjs",
    "pipeline:harvest": "node scripts/pipeline-harvest.mjs",
    "pipeline:process": "node scripts/pipeline-process.mjs",
    "pipeline:load": "node scripts/pipeline-load.mjs",
    "pipeline:models": "node scripts/pipeline-models.mjs",
    "pipeline:report": "node scripts/pipeline-report.mjs",
    "pipeline:compare": "node scripts/pipeline-compare.mjs",
    "pipeline:reset-limit": "node scripts/pipeline-reset-limit.mjs",
    "pipeline:rejudge": "node scripts/pipeline-rejudge.mjs",
    "pipeline:review": "node scripts/pipeline-review.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
