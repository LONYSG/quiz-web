{
  "name": "quiz-web",
  "private": true,
  "version": "0.1.0",
  "description": "실시간 상식 퀴즈 웹게임. 채팅 = 답안 구조의 선착순 멀티플레이.",
  "license": "MIT",
  "workspaces": [
    "shared",
    "server",
    "client",
    "pipeline"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev -w client",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b shared server client pipeline",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "db:reset": "node scripts/migrate.mjs --reset",
    "db:test-init": "node scripts/db-test-init.mjs",
    "bot": "node scripts/bot.mjs",
    "reset-password": "node scripts/reset-password.mjs",
    "verify:gemini": "node scripts/verify-gemini.mjs",
    "smoke": "node scripts/smoke.mjs",
    "answers:flex": "node scripts/answer-flex-report.mjs",
    "answers:near": "node scripts/answer-near-report.mjs",
    "feedback:report": "node scripts/feedback-report.mjs",
    "feedback:adopt": "node scripts/feedback-adopt.mjs",
    "points:grant": "node scripts/points-grant.mjs",
    "reports:report": "node scripts/reports-report.mjs",
    "reports:handle": "node scripts/reports-handle.mjs",
    "verify": "npm run typecheck && npm test && npm run smoke && npm run ui-check && npm run ui-check:sound && npm run ui-check:social && npm run ui-check:leave && npm run ui-check:spam && npm run ui-check:shop && npm run ui-check:copy && npm run ui-check:devices && npm run ui-check:minigame",
    "build:force": "tsc -b shared server client --force && npm run build -w client",
    "ui-check": "node scripts/ui-check.mjs",
    "ui-check:sound": "node scripts/ui-check.mjs --sound",
    "ui-check:social": "node scripts/ui-check.mjs --social",
    "ui-check:leave": "node scripts/ui-check.mjs --leave",
    "ui-check:spam": "node scripts/ui-check.mjs --spam",
    "ui-check:shop": "node scripts/ui-check.mjs --shop",
    "ui-check:copy": "node scripts/ui-check.mjs --copy",
    "ui-check:devices": "node scripts/ui-check.mjs --devices",
    "ui-check:minigame": "node scripts/ui-check.mjs --minigame",
    "pipeline:harvest": "node scripts/pipeline-harvest.mjs",
    "pipeline:process": "node scripts/pipeline-process.mjs",
    "pipeline:generate": "node scripts/pipeline-generate.mjs",
    "pipeline:load": "node scripts/pipeline-load.mjs",
    "pipeline:models": "node scripts/pipeline-models.mjs",
    "pipeline:report": "node scripts/pipeline-report.mjs",
    "pipeline:compare": "node scripts/pipeline-compare.mjs",
    "pipeline:reset-limit": "node scripts/pipeline-reset-limit.mjs",
    "pipeline:rejudge": "node scripts/pipeline-rejudge.mjs",
    "pipeline:review": "node scripts/pipeline-review.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
