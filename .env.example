# 환경 변수 템플릿. ★ 실제 값은 절대 이 파일에 쓰지 않는다.
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 .gitignore로 차단되어 있다.
# 저장소가 Public이므로 값이 한 번이라도 커밋되면 히스토리에 영구히 남는다. (guide 55-1절)

# --- 필수 ---
# 로컬 PostgreSQL 접속 문자열. docker-compose.yml 기준 기본 포트는 5434.
DATABASE_URL=

# 서버 수신 포트. 지정하지 않으면 3000을 사용한다.
PORT=

# 세션 쿠키 서명용 비밀 문자열. 충분히 긴 랜덤 값을 넣는다.
SESSION_SECRET=

# development | production
NODE_ENV=

# --- 선택 ---
# 서버가 초대 링크를 직접 만들어야 할 때만 사용한다.
# ★ 없어도 정상 동작한다. 초대 링크는 방장 브라우저에서
#   window.location.origin 으로 생성하는 것이 기본 방식이다. (R004 0장)
PUBLIC_BASE_URL=

# --- 데이터 파이프라인 (Track D) 전용. 게임 서버는 사용하지 않는다 ---
# Gemini API 키. GitHub Actions에서는 Secrets로만 주입한다.
GEMINI_API_KEY=
