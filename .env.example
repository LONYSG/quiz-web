# 환경 변수 템플릿. ★ 실제 값은 절대 이 파일에 쓰지 않는다.
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 .gitignore로 차단되어 있다.
# 저장소가 Public이므로 값이 한 번이라도 커밋되면 히스토리에 영구히 남는다. (guide 55-1절)

# --- 필수 ---
# 로컬 PostgreSQL 접속 문자열. docker-compose.yml 기준 기본 포트는 5434.
DATABASE_URL=

# 서버 수신 포트. 지정하지 않으면 3000을 사용한다.
PORT=

# 세션 쿠키 서명용 비밀 문자열. 충분히 긴 랜덤 값을 넣는다.
SESSION_SECRET=

# development | production
NODE_ENV=

# --- 선택 ---
# 서버가 초대 링크를 직접 만들어야 할 때만 사용한다.
# ★ 없어도 정상 동작한다. 초대 링크는 방장 브라우저에서
#   window.location.origin 으로 생성하는 것이 기본 방식이다. (R004 0장)
PUBLIC_BASE_URL=

# --- ★ R107 고정 주소(Cloudflare 이름 붙인 터널) — 둘 다 있을 때만 고정 주소, 아니면 임시 주소(trycloudflare) ---
# 순서: docs/11-DEPLOY.md "도메인 연결 — 한 번만"
# 터널 이름(cloudflared tunnel create 에 쓴 이름)
TUNNEL_NAME=
# 게임 주소의 호스트 이름(https:// 없이 — 예: quizdojang.com)
PUBLIC_HOSTNAME=
# 터널 설정 파일 경로(비우면 %USERPROFILE%\.cloudflared\config.yml)
TUNNEL_CONFIG=

# --- ★ R109 두 자리(공개 · 베타) — PUBLIC_HOSTNAME 이 있을 때만 자리를 가른다(없으면 오늘처럼 전부 베타 자리 · 계정 검사 없음) ---
# 베타(지인) 주소의 호스트 이름(예: beta.quizdojang.com) — 이 주소로 들어오면 지인 계정만 · 노래 · 상품 그림 · 치이카와가 나온다
FRIEND_HOSTNAME=
# 검사용(dev 3001): 모든 요청을 한 자리로 — public | friend (실 서버에는 두지 않는다)
SITE_FORCE=

# --- ★ R107 보안 ---
# 서버가 듣는 주소. 비우면 127.0.0.1(이 PC 안에서만 — 터널은 루프백으로 들어온다). 다른 기기에서 직접 붙어야 할 때만 0.0.0.0
HOST=
# DB 비밀번호(docker-compose.yml 이 읽는다 · 비우면 옛 값). 바꾸는 순서는 docs/11 — DATABASE_URL 도 함께 바꾼다
POSTGRES_PASSWORD=
# 한도 값(SEC_*)은 docs/21-SECURITY.md 표 — 보통 비워 둔다(기본값)

# --- 데이터 파이프라인 (Track D) 전용. 게임 서버는 사용하지 않는다 ---
# Gemini API 키. GitHub Actions에서는 Secrets로만 주입한다.
GEMINI_API_KEY=
